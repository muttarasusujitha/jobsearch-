# Copy to .env (it's git-ignored) and fill in. Docker Compose reads it automatically.

# Gmail app password for the tracker service (Google account > Security > App passwords)
JOBAGENT_EMAIL_PASSWORD=

# Optional: require this token on every API call (the dashboard and services send it automatically)
JOBAGENT_API_TOKEN=

# Optional: password for the noVNC browser viewer at http://localhost:6080
VNC_PASSWORD=

TZ=Asia/Kolkata
